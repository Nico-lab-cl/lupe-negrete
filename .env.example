# Copiar a .env y ajustar. .env NO se sube al repositorio.

# --- Conexión a la base de datos ---

# Para correr la app y las herramientas de Prisma DESDE TU EQUIPO contra el
# Postgres del compose (que publica el puerto 5432).
DATABASE_URL="postgresql://lupe:lupe@localhost:5432/lupe_negrete?schema=public"

# Solo si necesitas que los contenedores usen otra base de datos (por ejemplo
# una gestionada en producción). Si lo dejas vacío, dentro de compose se usa
# el servicio `db`: postgresql://lupe:lupe@db:5432/lupe_negrete?schema=public
# APP_DATABASE_URL=""

# --- Aplicación ---

# Sal para el hash de IP que guarda /api/leads. Cambiar en producción.
IP_HASH_SALT="cambiar-esto-en-produccion"

# --- Contenedor de Postgres ---
# Si cambias estas credenciales, actualiza también DATABASE_URL / APP_DATABASE_URL.
POSTGRES_USER=lupe
POSTGRES_PASSWORD=lupe
POSTGRES_DB=lupe_negrete
