---
import { SITE_CONFIG } from '../config/site';
import { getEquivalentPath, type Lang } from '../lib/i18n';
import SkipLink from '../components/layout/SkipLink.astro';
import UrgencyBar from '../components/conversion/UrgencyBar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
  jsonLd?: Record<string, any>[];
}

const {
  title,
  description,
  lang,
  ogImage = '/images/banner-campaign.png',
  jsonLd = []
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = SITE_CONFIG.siteUrl;
const canonicalUrl = `${siteUrl}${currentPath}`;
const esPath = lang === 'es' ? currentPath : getEquivalentPath(currentPath, 'es');
const enPath = lang === 'en' ? currentPath : getEquivalentPath(currentPath, 'en');

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Base Schema.org JSON-LD for Candidate & Committee
const defaultJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE_CONFIG.candidate.name,
    alternateName: [SITE_CONFIG.candidate.alternateName, 'Lupe Negrete', 'Lupe Navarrete', 'Guadalupe Negrete'],
    jobTitle: SITE_CONFIG.candidate.office[lang],
    description: SITE_CONFIG.candidate.positioningLine[lang],
    url: siteUrl,
    image: `${siteUrl}/images/candidate-portrait-navy.png`,
    affiliation: {
      '@type': 'PoliticalParty',
      name: SITE_CONFIG.candidate.party[lang]
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Eagle Pass',
      addressRegion: 'TX',
      postalCode: '78852',
      addressCountry: 'US'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_CONFIG.committee.legalName,
    url: siteUrl,
    logo: `${siteUrl}/images/logo-es.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Campaign Office',
      email: SITE_CONFIG.committee.email,
      availableLanguage: ['Spanish', 'English']
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Lupe Negrete · Comisionado Precinto 4',
    url: siteUrl
  },
  ...jsonLd
];
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Lupe Negrete</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-es.png" />

    <!-- Reciprocal hreflang & x-default -->
    <link rel="alternate" hreflang="es" href={`${siteUrl}${esPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Lupe Negrete`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | Lupe Negrete`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Google Fonts Preload: Archivo (Headings) and Public Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />

    <!-- UTM capture on client load -->
    <script>
      import { saveUtmsFromUrl } from '../lib/leads';
      saveUtmsFromUrl();
    </script>
  </head>
  <body class="bg-bone text-ink min-h-screen flex flex-col antialiased selection:bg-red-cta selection:text-white">
    <SkipLink lang={lang} />
    <UrgencyBar lang={lang} />
    <Header lang={lang} currentPath={currentPath} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
