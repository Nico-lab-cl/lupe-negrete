---
import { SITE_CONFIG } from '../config/site';
import { getEquivalentPath, type Lang } from '../lib/i18n';
import { buildGraph, type Breadcrumb, type PageType } from '../lib/schema';
import SkipLink from '../components/layout/SkipLink.astro';
import UrgencyBar from '../components/conversion/UrgencyBar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
  jsonLd?: Record<string, any>[];
  /** Tipo de pagina para Schema.org. */
  pageType?: PageType;
  /** Migas de pan; el layout antepone la portada del idioma. */
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  lang,
  ogImage = '/images/banner-campaign.png',
  jsonLd = [],
  pageType = 'WebPage',
  breadcrumbs = []
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = SITE_CONFIG.siteUrl;
const canonicalUrl = `${siteUrl}${currentPath}`;
const esPath = lang === 'es' ? currentPath : getEquivalentPath(currentPath, 'es');
const enPath = lang === 'en' ? currentPath : getEquivalentPath(currentPath, 'en');

// Google corta el title sobre los ~60-65 caracteres. No repetimos la marca
// cuando el propio titulo ya la incluye: son 15 caracteres que se comen el
// final de la frase justo donde va lo distintivo de cada pagina.
const tituloCompleto = /negrete/i.test(title) ? title : title + ' | Lupe Negrete';

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Base Schema.org JSON-LD for Candidate & Committee
const inicio = lang === 'es' ? '/es/' : '/en/';
const migas: Breadcrumb[] = breadcrumbs.length
  ? [{ name: lang === 'es' ? 'Inicio' : 'Home', href: inicio }, ...breadcrumbs]
  : [];

const jsonLdGraph = buildGraph({
  lang,
  pageType,
  title,
  description,
  url: currentPath,
  image: ogImage,
  breadcrumbs: migas,
  extra: jsonLd
});
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-es.png" />

    <!-- Reciprocal hreflang & x-default -->
    <link rel="alternate" hreflang="es" href={`${siteUrl}${esPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${tituloCompleto}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${tituloCompleto}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Google Fonts Preload: Archivo (Headings) and Public Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- UTM capture on client load -->
    <script>
      import { saveUtmsFromUrl } from '../lib/leads';
      saveUtmsFromUrl();
    </script>
  </head>
  <body class="bg-bone text-ink min-h-screen flex flex-col antialiased selection:bg-red-cta selection:text-white">
    <SkipLink lang={lang} />
    <UrgencyBar lang={lang} />
    <Header lang={lang} currentPath={currentPath} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
