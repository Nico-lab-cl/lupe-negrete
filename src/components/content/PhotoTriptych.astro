---
interface PhotoItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos: PhotoItem[];
  className?: string;
}

const { photos, className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 md:grid-cols-3 gap-4 my-8 ${className}`}>
  {photos.map((photo) => (
    <figure class="rounded-xl overflow-hidden shadow-md bg-white border border-slate-200/80 group">
      <div class="aspect-[4/3] overflow-hidden bg-slate-100">
        <img
          src={photo.src}
          alt={photo.alt}
          class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-103"
          loading="lazy"
        />
      </div>
      {photo.caption && (
        <figcaption class="p-3 text-xs text-slate-600 font-medium bg-white">
          {photo.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
