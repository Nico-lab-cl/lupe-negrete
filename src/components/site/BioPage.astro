---
// Página de biografía con el mismo lenguaje visual que la home: Saira
// Condensed para los titulares, IBM Plex Mono para las etiquetas, los cortes
// en diagonal (skewX -12deg) y la misma paleta navy/rojo.
import type { Lang } from '../../lib/i18n';
import { BIO_COPY } from '../../lib/bio-copy';
import TopBar from './TopBar.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import StickyBar from './StickyBar.astro';
import { routes } from './SiteChrome';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = BIO_COPY[lang];
const R = routes(lang);

const triptico1 = [
  { src: '/images/candidate-border.png', alt: t.alt1, cap: t.cap1 },
  { src: '/images/hero-candidate-walking.png', alt: t.alt2, cap: t.cap2 },
  { src: '/images/candidate-listening.png', alt: t.alt3, cap: t.cap3 }
];

const triptico2 = [
  { src: '/images/candidate-assembly.png', alt: t.alt4, cap: t.cap4 },
  { src: '/images/candidate-courthouse.png', alt: t.alt5, cap: t.cap5 },
  { src: '/images/candidate-portrait-brown.png', alt: t.alt6, cap: t.cap6 }
];

const actos = [
  { label: t.act1Label, h: t.act1H, p1: t.act1P1, p2: t.act1P2, fotos: triptico1, fondo: '#F7F5F0', barra: '#D3151D' },
  { label: t.act2Label, h: t.act2H, p1: t.act2P1, p2: t.act2P2, fotos: null, fondo: '#fff', barra: '#003399' },
  { label: t.act3Label, h: t.act3H, p1: t.act3P1, p2: t.act3P2, fotos: triptico2, fondo: '#F7F5F0', barra: '#06132B' }
];
---

<div style="min-height:100vh;background:#F7F5F0">

<TopBar lang={lang} />
<SiteHeader lang={lang} />

<main id="main-content">

<section style="position:relative;background:#06132B;overflow:hidden">
<div data-px="0.14" style="position:absolute;top:-120px;right:-60px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(0,51,153,.5),transparent 68%);pointer-events:none"></div>
<div data-px="0.07" data-pxb="skewX(-12deg)" style="position:absolute;left:56%;top:0;bottom:0;width:180px;background:#FF3131;opacity:.1;transform:skewX(-12deg);pointer-events:none"></div>
<div style="position:relative;max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(24px,4vw,48px);align-items:center">

<div style="padding:clamp(38px,6vw,62px) 0 clamp(40px,6vw,66px);animation:lnUp .6s cubic-bezier(.16,1,.3,1) both">
<div style="display:inline-flex;align-items:stretch;margin-bottom:26px;transform:skewX(-12deg);box-shadow:0 8px 22px rgba(0,0,0,.32)">
<span style="display:flex;align-items:center;background:#FF3131;padding:8px 13px 7px"><span style="display:block;transform:skewX(12deg);font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:23px;line-height:1;letter-spacing:.02em;color:#fff">P4</span></span>
<span style="display:flex;align-items:center;background:#fff;padding:8px 15px 7px"><span style="display:block;transform:skewX(12deg);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:10px;line-height:1;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.kicker}</span></span>
</div>

<h1 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(52px,10vw,116px);line-height:.83;letter-spacing:-.012em;text-transform:uppercase;color:#fff">
<span style="display:block">{t.h1a}</span>
<span style="display:block;color:#FF3131">{t.h1b}</span>
</h1>

<div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px clamp(12px,2.6vw,18px);margin:26px 0 20px">
<span style="flex:none;width:46px;height:4px;background:#FF3131;transform:skewX(-12deg)"></span>
<p style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(17px,4vw,22px);letter-spacing:.03em;text-transform:uppercase;color:#fff">{t.positioning}</p>
</div>

<p style="margin:0 0 14px;max-width:540px;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(22px,4.6vw,28px);line-height:1.1;letter-spacing:.01em;text-transform:uppercase;color:#F59E0B">{t.lead}</p>
<p style="margin:0;max-width:540px;font-size:clamp(15px,3.6vw,16.5px);line-height:1.68;color:rgba(255,255,255,.72)">{t.leadP1}</p>
<p style="margin:14px 0 0;max-width:540px;font-size:clamp(14px,3.4vw,15.5px);line-height:1.68;color:rgba(255,255,255,.58)">{t.leadP2}</p>
</div>

<div style="position:relative;display:flex;align-items:flex-end;justify-content:center;min-height:clamp(340px,48vw,520px);padding-bottom:clamp(24px,4vw,40px)">
<div style="position:absolute;bottom:0;right:-24px;left:-24px;top:36px;background:#0B224E;clip-path:polygon(9% 0,100% 0,100% 100%,0 100%)"></div>
<img data-px="-0.05" src="/images/candidate-portrait-navy.png" alt={t.altPortrait} width="1080" height="1350" fetchpriority="high" style="position:relative;width:100%;max-width:400px;height:auto;display:block;border-radius:6px;filter:drop-shadow(0 24px 50px rgba(0,0,0,.5))" />
</div>

</div>
</section>

{actos.map((a) => (
<section style={`background:${a.fondo};border-top:1px solid #E4E7EC`}>
<div style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,72px) clamp(16px,4vw,24px)">

<div data-rv="0" style="max-width:820px;margin-bottom:26px">
<div style="display:inline-flex;align-items:center;margin-bottom:16px;transform:skewX(-12deg)">
<span style={`display:flex;align-items:center;background:${a.barra};padding:6px 14px 5px`}><span style="display:block;transform:skewX(12deg);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;line-height:1;letter-spacing:.14em;text-transform:uppercase;color:#fff">{a.label}</span></span>
</div>
<h2 style="margin:0 0 18px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(34px,4.6vw,64px);line-height:.9;letter-spacing:-.012em;text-transform:uppercase;color:#06132B">{a.h}</h2>
<p style="margin:0 0 14px;font-size:16.5px;line-height:1.72;color:#475467;text-wrap:pretty">{a.p1}</p>
<p style="margin:0;font-size:16.5px;line-height:1.72;color:#475467;text-wrap:pretty">{a.p2}</p>
</div>

{a.fotos && (
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:24px;margin-top:36px">
{a.fotos.map((f, i) => (
<figure data-rv={String(i * 0.13)} class="h-card" style={`margin:0;background:#fff;border:1px solid #E4E7EC;border-top:5px solid ${['#D3151D', '#003399', '#06132B'][i]};border-radius:6px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s`}>
<div style="position:relative;aspect-ratio:16/10;overflow:hidden;background:#E4E7EC">
<img src={f.src} alt={f.alt} loading="lazy" width="1080" height="1350" style="width:100%;height:100%;object-fit:cover" />
</div>
<figcaption style="padding:18px 20px;font-size:13.5px;line-height:1.6;color:#475467;flex:1">{f.cap}</figcaption>
</figure>
))}
</div>
)}

</div>
</section>
))}

<section style="position:relative;background:#D3151D;overflow:hidden">
<div data-px="0.13" style="position:absolute;top:-90px;left:-40px;width:340px;height:340px;border-radius:50%;background:rgba(255,255,255,.07);pointer-events:none"></div>
<div data-px="0.07" data-pxb="skewX(-12deg)" style="position:absolute;right:8%;top:0;bottom:0;width:130px;background:rgba(6,19,43,.14);transform:skewX(-12deg);pointer-events:none"></div>
<div data-rv="0" style="position:relative;max-width:900px;margin:0 auto;padding:clamp(48px,7vw,78px) clamp(16px,4vw,24px);text-align:center">
<span style="display:inline-block;width:52px;height:4px;background:#fff;transform:skewX(-12deg);margin-bottom:26px"></span>
<blockquote style="margin:0 0 20px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(26px,4.4vw,50px);line-height:1.02;letter-spacing:-.01em;text-transform:uppercase;color:#fff;text-wrap:balance">{t.quote}</blockquote>
<p style="margin:0;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.82)">{t.quoteBy}</p>
</div>
</section>

<section style="background:#06132B;border-top:4px solid #FF3131">
<div data-rv="0" style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,68px) clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:clamp(28px,5vw,48px);align-items:center">
<div>
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#F59E0B">{t.ctaKicker}</p>
<h2 style="margin:0 0 14px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(34px,4.4vw,58px);line-height:.9;letter-spacing:-.012em;text-transform:uppercase;color:#fff">{t.ctaH}</h2>
<p style="margin:0;font-size:16px;line-height:1.68;color:rgba(255,255,255,.7);max-width:520px">{t.ctaBody}</p>
</div>
<div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:flex-start">
<a href={R.issues} class="h-cta" style="background:#D3151D;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px;box-shadow:0 8px 26px rgba(211,21,29,.36)">{t.ctaIssues}</a>
<a href={R.vote} class="h-ghost" style="background:transparent;border:1.5px solid rgba(255,255,255,.34);color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px">{t.ctaVote}</a>
<a href={`${R.home}#sumate`} class="h-ghost" style="background:transparent;border:1.5px solid rgba(255,255,255,.34);color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px">{t.ctaJoin}</a>
</div>
</div>
</section>

</main>

<SiteFooter lang={lang} />

<StickyBar lang={lang} />

</div>

<script>
  import '../../scripts/site-chrome';
</script>
