---
// Pie de página. Compartido por todas las páginas.
import type { Lang } from '../../lib/i18n';
import { COPY } from '../../lib/home-copy';
import { SITE_CONFIG } from '../../config/site';
import { getWhatsAppUrl } from '../../lib/whatsapp';
import { anchorBase, routes, LOGO } from './SiteChrome';

interface Props {
  lang: Lang;
  isHome?: boolean;
}

const { lang, isHome = false } = Astro.props;
const t = COPY[lang];
const b = anchorBase(lang, isHome);
const R = routes(lang);

const nav = [
  { href: `${b}#conoce`, label: t.navMeet },
  { href: `${b}#propuestas`, label: t.navIssues },
  { href: `${b}#votar`, label: t.navVote },
  { href: `${b}#precinto`, label: t.navPrecinct }
];

// El teléfono de campaña es también el de WhatsApp.
const waUrl = getWhatsAppUrl('general', lang);
const telHref = `tel:+${SITE_CONFIG.committee.whatsappNumber}`;
const waLabel = lang === 'es' ? 'WhatsApp de campaña' : 'Campaign WhatsApp';
---

<footer id="footer" style="background:#06132B;color:#fff;border-top:4px solid #102D66">
<div style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,64px) clamp(16px,4vw,24px) clamp(112px,18vw,124px)">
<div data-rv="0" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:44px;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.12)">
<div>
<span style="display:inline-block;background:rgba(255,255,255,.96);padding:10px 14px;border-radius:6px;margin-bottom:18px"><img src={LOGO.src} alt={t.logoAlt} loading="lazy" width={LOGO.w} height={LOGO.h} style="width:230px;height:auto;display:block" /></span>
<p style="margin:0 0 12px;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:22px;letter-spacing:.02em;text-transform:uppercase;color:#fff">{t.footMotto}</p>
<p style="margin:0;font-size:14px;line-height:1.68;color:rgba(255,255,255,.62);max-width:400px">{t.footDesc}</p>
</div>
<div>
<p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.45)">{t.footNav}</p>
<div style="display:flex;flex-direction:column;gap:10px">
{nav.map((n) => (
<a href={n.href} class="h-red-logo" style="font-size:14px;font-weight:500;color:rgba(255,255,255,.85)">{n.label}</a>
))}
<a href={R.privacy} class="h-white-soft" style="font-size:12.5px;color:rgba(255,255,255,.5)">{t.privacy}</a>
<a href={R.accessibility} class="h-white-soft" style="font-size:12.5px;color:rgba(255,255,255,.5)">{t.accessibility}</a>
</div>
</div>
<div>
<p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.45)">{t.footContact}</p>
<div style="display:flex;flex-direction:column;gap:10px;font-size:14px;color:rgba(255,255,255,.8)">
<span>{SITE_CONFIG.committee.address}</span>
<a href={`mailto:${SITE_CONFIG.committee.email[lang]}`} class="h-red-logo" style="color:rgba(255,255,255,.8)">{SITE_CONFIG.committee.email[lang]}</a>
<a href={telHref} class="h-red-logo" style="font-family:'IBM Plex Mono',monospace;font-size:13.5px;color:rgba(255,255,255,.8)">{SITE_CONFIG.committee.phone}</a>
</div>
<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:18px">
<a href={SITE_CONFIG.social.facebook} target="_blank" rel="noopener noreferrer" class="h-navy" style="display:inline-flex;align-items:center;gap:9px;background:#102D66;border:1px solid rgba(255,255,255,.16);color:#fff;font-size:12.5px;font-weight:600;padding:10px 14px;border-radius:5px">
<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.688 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"></path></svg>
<span>{t.fbOfficial}</span>
</a>
<a href={waUrl} target="_blank" rel="noopener noreferrer" class="h-wa" style="display:inline-flex;align-items:center;gap:9px;background:#128C7E;border:1px solid rgba(255,255,255,.16);color:#fff;font-size:12.5px;font-weight:600;padding:10px 14px;border-radius:5px">
<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.944c0 2.096.548 4.142 1.588 5.945L0 24l6.335-1.652a11.882 11.882 0 005.683 1.448h.005c6.582 0 11.941-5.359 11.944-11.945A11.86 11.86 0 0020.52 3.45"></path></svg>
<span>{waLabel}</span>
</a>
</div>
</div>
</div>
<div style="padding-top:26px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px">
<p style="margin:0;font-size:12px;letter-spacing:.02em;color:rgba(255,255,255,.55);text-transform:uppercase;font-weight:600">{SITE_CONFIG.committee.disclaimerTextEn}</p>
<p style="margin:0;font-size:12px;color:rgba(255,255,255,.45)">{t.copyright}</p>
</div>
</div>
</footer>
