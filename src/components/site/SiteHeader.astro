---
// Cabecera fija con logo, navegación y menú móvil. Compartida por todas las páginas.
import type { Lang } from '../../lib/i18n';
import { COPY } from '../../lib/home-copy';
import { anchorBase, routes, LOGO } from './SiteChrome';

interface Props {
  lang: Lang;
  isHome?: boolean;
}

const { lang, isHome = false } = Astro.props;
const t = COPY[lang];
const b = anchorBase(lang, isHome);
const R = routes(lang);

const nav = [
  { href: `${b}#conoce`, label: t.navMeet },
  { href: `${b}#propuestas`, label: t.navIssues },
  { href: `${b}#votar`, label: t.navVote },
  { href: `${b}#precinto`, label: t.navPrecinct }
];
---

<header data-hdr style="position:sticky;top:0;z-index:1100;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid #E4E7EC;transition:box-shadow .35s cubic-bezier(.16,1,.3,1)">
<div data-hdr-row style="max-width:1280px;margin:0 auto;padding:10px clamp(14px,4vw,24px);display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:72px;transition:min-height .35s cubic-bezier(.16,1,.3,1),padding .35s cubic-bezier(.16,1,.3,1)">
<a href={isHome ? '#top' : R.home} style="display:flex;align-items:center;flex:none"><img data-hdr-logo src={LOGO.src} alt={t.logoAlt} width={LOGO.w} height={LOGO.h} style="width:clamp(146px,34vw,238px);height:auto;display:block;transition:width .35s cubic-bezier(.16,1,.3,1)" /></a>
<nav style="display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px 16px">
<span class="nav-wide">
{nav.map((n) => (
<a href={n.href} class="h-nav" style="color:#14161A;font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap">{n.label}</a>
))}
</span>
<button type="button" data-menu-toggle aria-label={t.menu} aria-expanded="false" aria-controls="ln-mobile-menu" class="nav-narrow h-menubtn" style="flex-direction:column;justify-content:center;gap:5px;width:46px;height:44px;padding:0 11px;background:none;border:1.5px solid #D0D5DD;border-radius:5px;cursor:pointer">
<span style="display:block;height:2px;background:#06132B;border-radius:2px"></span>
<span style="display:block;height:2px;background:#06132B;border-radius:2px"></span>
<span style="display:block;height:2px;background:#06132B;border-radius:2px"></span>
</button>
<a href={`${b}#votar`} class="h-cta" style="background:#D3151D;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:17px;letter-spacing:.03em;text-transform:uppercase;padding:11px 20px;border-radius:4px;white-space:nowrap;box-shadow:0 4px 14px rgba(211,21,29,.28)">{t.join}</a>
</nav>
</div>
<nav id="ln-mobile-menu" data-mobile-menu style="border-top:1px solid #E4E7EC;background:#fff;padding:8px 16px 16px;flex-direction:column">
{nav.map((n, i) => (
<a href={n.href} data-menu-close class="h-nav" style={`display:flex;align-items:center;min-height:52px;font-size:15px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#06132B${i < nav.length - 1 ? ';border-bottom:1px solid #EEF0F3' : ''}`}>{n.label}</a>
))}
</nav>
</header>
