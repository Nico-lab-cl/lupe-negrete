---
// Página de gracias tras enviar cualquier formulario del sitio. Mantiene el
// orden y la paleta del resto: barra roja, cabecera fija, héroe navy,
// contenido sobre bone, cierre navy, pie y barra fija inferior.
import type { Lang } from '../../lib/i18n';
import { THANKS_COPY } from '../../lib/thanks-copy';
import { SITE_CONFIG } from '../../config/site';
import TopBar from './TopBar.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import StickyBar from './StickyBar.astro';
import { routes } from './SiteChrome';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = THANKS_COPY[lang];
const R = routes(lang);

// wa.me sin número abre el selector de contactos: comparte con quien quieran.
const shareUrl = `https://wa.me/?text=${encodeURIComponent(
  `${t.shareText} ${SITE_CONFIG.siteUrl}${R.home}`
)}`;

const pasos = [
  {
    label: t.step1Label,
    h: t.step1H,
    p: t.step1P,
    cta: t.step1Cta,
    href: shareUrl,
    externo: true,
    barra: '#D3151D'
  },
  {
    label: t.step2Label,
    h: t.step2H,
    p: t.step2P,
    cta: t.step2Cta,
    href: `${R.home}#votar`,
    externo: false,
    barra: '#F59E0B'
  },
  {
    label: t.step3Label,
    h: t.step3H,
    p: t.step3P,
    cta: t.step3Cta,
    href: R.issues,
    externo: false,
    barra: '#003399'
  }
];
---

<div style="min-height:100vh;background:#F7F5F0">

<TopBar lang={lang} />
<SiteHeader lang={lang} />

<main id="main-content">

<section style="position:relative;background:#06132B;overflow:hidden">
<div data-px="0.14" style="position:absolute;top:-120px;right:-60px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(0,51,153,.5),transparent 68%);pointer-events:none"></div>
<div data-px="0.07" data-pxb="skewX(-12deg)" style="position:absolute;left:60%;top:0;bottom:0;width:180px;background:#FF3131;opacity:.1;transform:skewX(-12deg);pointer-events:none"></div>
<div style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(44px,6vw,72px) clamp(16px,4vw,24px) clamp(48px,6vw,76px);animation:lnUp .6s cubic-bezier(.16,1,.3,1) both">

<div style="display:inline-flex;align-items:stretch;margin-bottom:28px;transform:skewX(-12deg);box-shadow:0 8px 22px rgba(0,0,0,.32)">
<span style="display:flex;align-items:center;background:#059669;padding:8px 13px 7px"><span style="display:flex;transform:skewX(12deg);color:#fff">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
</span></span>
<span style="display:flex;align-items:center;background:#fff;padding:8px 15px 7px"><span style="display:block;transform:skewX(12deg);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:10px;line-height:1;letter-spacing:.16em;text-transform:uppercase;color:#059669">{t.kicker}</span></span>
</div>

<h1 style="margin:0;max-width:14ch;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(44px,8.4vw,104px);line-height:.86;letter-spacing:-.012em;text-transform:uppercase;color:#fff">
<span style="display:block">{t.h1a}</span>
<span style="display:block;color:#FF3131">{t.h1b}</span>
</h1>

<div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px clamp(12px,2.6vw,18px);margin:26px 0 18px">
<span style="flex:none;width:46px;height:4px;background:#FF3131;transform:skewX(-12deg)"></span>
<p style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(18px,4.4vw,24px);letter-spacing:.03em;text-transform:uppercase;color:#fff">{t.lead}</p>
</div>

<p style="margin:0;max-width:620px;font-size:clamp(15px,3.6vw,17px);line-height:1.68;color:rgba(255,255,255,.72)">{t.sub}</p>
</div>
</section>

<section style="background:#F7F5F0;border-top:4px solid #FF3131;border-bottom:1px solid #E4E7EC">
<div style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,72px) clamp(16px,4vw,24px)">

<div data-rv="0" style="max-width:820px;margin-bottom:36px">
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.stepsKicker}</p>
<h2 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(34px,4.6vw,64px);line-height:.9;letter-spacing:-.012em;text-transform:uppercase;color:#06132B">{t.stepsH}</h2>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px">
{pasos.map((s, i) => (
<article data-rv={String(i * 0.13)} class="h-card" style={`background:#fff;border:1px solid #E4E7EC;border-top:5px solid ${s.barra};border-radius:6px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s`}>
<div style="padding:24px;display:flex;flex-direction:column;gap:12px;flex:1">
<span style={`align-self:flex-start;background:${s.barra};color:#fff;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:6px 12px`}>{s.label}</span>
<h3 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:30px;line-height:.95;text-transform:uppercase;color:#06132B">{s.h}</h3>
<p style="margin:0;font-size:14.5px;line-height:1.66;color:#475467;flex:1">{s.p}</p>
{s.externo ? (
<a href={s.href} target="_blank" rel="noopener noreferrer" class="h-nav" style="display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#06132B;padding-top:12px;border-top:1px solid #E4E7EC">{s.cta}</a>
) : (
<a href={s.href} class="h-nav" style="display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#06132B;padding-top:12px;border-top:1px solid #E4E7EC">{s.cta}</a>
)}
</div>
</article>
))}
</div>

</div>
</section>

<section style="background:#06132B;border-top:4px solid #FF3131">
<div data-rv="0" style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,68px) clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:clamp(28px,5vw,48px);align-items:center">
<div>
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#F59E0B">{t.ctaKicker}</p>
<h2 style="margin:0 0 14px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(34px,4.4vw,58px);line-height:.9;letter-spacing:-.012em;text-transform:uppercase;color:#fff">{t.ctaH}</h2>
<p style="margin:0;font-size:16px;line-height:1.68;color:rgba(255,255,255,.7);max-width:520px">{t.ctaBody}</p>
</div>
<div style="display:flex;flex-wrap:wrap;gap:12px">
<a href={R.contact} class="h-cta" style="background:#D3151D;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px;box-shadow:0 8px 26px rgba(211,21,29,.36)">{t.ctaContact}</a>
<a href={R.home} class="h-ghost" style="background:transparent;border:1.5px solid rgba(255,255,255,.34);color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px">{t.ctaHome}</a>
</div>
</div>
</section>

</main>

<SiteFooter lang={lang} />

<StickyBar lang={lang} />

</div>

<script>
  import '../../scripts/site-chrome';
</script>
