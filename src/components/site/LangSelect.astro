---
// Selector de idioma colapsado: muestra el idioma actual y, al pulsarlo,
// despliega la lista para elegir. Se construye sobre <details> a propósito —
// abre y cierra sin JavaScript, así que sigue sirviendo si el script falla o
// tarda; el script solo añade el cierre al pulsar fuera y con Escape.
//
// Dos variantes porque hay dos cabeceras: `bar` para la franja roja superior
// (fondo oscuro) y `light` para la cabecera blanca de las páginas interiores.
import { getEquivalentPath, type Lang } from '../../lib/i18n';
import FlagIcon from '../home/FlagIcon.astro';

interface Props {
  lang: Lang;
  variant?: 'bar' | 'light';
}

const { lang, variant = 'bar' } = Astro.props;

// El cambio de idioma lleva a la página equivalente, no siempre a la portada:
// desde /es/biografia/ debe caer en /en/about/.
const aqui = Astro.url.pathname;

const OPCIONES = [
  { code: 'es' as const, label: 'ES', name: 'Español', flag: 'mx' as const },
  { code: 'en' as const, label: 'EN', name: 'English', flag: 'us' as const }
];

const actual = OPCIONES.find((o) => o.code === lang) ?? OPCIONES[0];
const etiqueta =
  lang === 'es'
    ? `Idioma: ${actual.name}. Cambiar idioma`
    : `Language: ${actual.name}. Change language`;
---

<details class={`lang lang--${variant}`} data-lang-select>
  <summary class="lang__btn" aria-label={etiqueta} title={etiqueta}>
    <FlagIcon country={actual.flag} />
    <span class="lang__code">{actual.label}</span>
    <svg class="lang__caret" viewBox="0 0 10 6" aria-hidden="true">
      <path
        d="M1 1l4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </summary>

  <ul class="lang__menu">
    {OPCIONES.map((o) => (
      <li>
        <a
          href={getEquivalentPath(aqui, o.code)}
          class="lang__opt"
          data-lang-switch={o.code}
          lang={o.code}
          hreflang={o.code}
          aria-current={o.code === lang ? 'true' : undefined}
        >
          <FlagIcon country={o.flag} />
          <span class="lang__name">{o.name}</span>
          <span class="lang__tag">{o.label}</span>
          {o.code === lang && (
            <svg class="lang__check" viewBox="0 0 14 14" aria-hidden="true">
              <path
                d="M2.5 7.5l3 3 6-6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang {
    position: relative;
    display: inline-block;
    flex: none;
    /* Por encima de la cabecera fija (z-index 1100) para que el desplegable
       no quede cortado por ella. */
    z-index: 1200;
  }
  .lang[open] {
    z-index: 1300;
  }

  /* ---------- Botón colapsado ---------- */
  .lang__btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 9px;
    border-radius: 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  /* El triángulo que el navegador dibuja por defecto en <summary>. */
  .lang__btn::-webkit-details-marker {
    display: none;
  }
  .lang__btn::marker {
    content: '';
  }

  .lang__caret {
    width: 9px;
    height: 9px;
    flex: none;
    opacity: 0.85;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lang[open] .lang__caret {
    transform: rotate(180deg);
  }

  .lang--bar .lang__btn {
    min-height: 24px;
    background: rgba(6, 19, 43, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.26);
    color: #fff;
  }
  .lang--bar .lang__btn:hover,
  .lang--bar[open] .lang__btn {
    background: rgba(6, 19, 43, 0.5);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .lang--light .lang__btn {
    min-height: 34px;
    padding: 6px 10px;
    background: #fff;
    border: 1px solid #d0d5dd;
    color: #06132b;
    box-shadow: 0 1px 2px rgba(6, 19, 43, 0.06);
  }
  .lang--light .lang__btn:hover,
  .lang--light[open] .lang__btn {
    border-color: #06132b;
  }

  /* ---------- Lista desplegada ---------- */
  .lang__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    margin: 0;
    padding: 5px;
    list-style: none;
    min-width: 198px;
    max-width: min(260px, calc(100vw - 28px));
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    box-shadow: 0 16px 40px rgba(6, 19, 43, 0.24);
    text-align: left;
    /* La barra roja pone todo en mayúsculas; dentro del desplegable los
       nombres de idioma se leen mejor tal y como se escriben. */
    text-transform: none;
    letter-spacing: normal;
    animation: langIn 0.18s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .lang__opt {
    display: flex;
    align-items: center;
    gap: 10px;
    /* 44px: objetivo táctil cómodo en móvil. */
    min-height: 44px;
    padding: 0 10px;
    border-radius: 5px;
    color: #14161a;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.16s, color 0.16s;
  }
  .lang__opt:hover,
  .lang__opt:focus-visible {
    background: #f2f4f7;
    color: #14161a;
  }

  .lang__name {
    flex: 1;
  }
  .lang__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #667085;
  }
  .lang__check {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .lang__opt[aria-current],
  .lang__opt[aria-current]:hover {
    background: #06132b;
    color: #fff;
  }
  .lang__opt[aria-current] .lang__tag {
    color: rgba(255, 255, 255, 0.7);
  }

  @keyframes langIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Pantallas estrechas ---------- */
  @media (max-width: 640px) {
    /* El botón vive en una franja muy compacta; en táctil necesita más área. */
    .lang--bar .lang__btn {
      min-height: 30px;
      padding: 6px 10px;
      font-size: 12px;
    }
  }

  @media (max-width: 520px) {
    /* Anclado a la derecha se saldría de la pantalla cuando el ajuste de línea
       de la barra deja el botón centrado: se centra sobre él. */
    .lang__menu {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      animation-name: langInCentro;
    }
  }

  @keyframes langInCentro {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang__menu {
      animation: none;
    }
    .lang__caret {
      transition: none;
    }
  }
</style>

<script>
  const selectores = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-select]')
  );

  if (selectores.length) {
    const cerrar = (excepto?: HTMLDetailsElement) => {
      selectores.forEach((d) => {
        if (d !== excepto) d.removeAttribute('open');
      });
    };

    selectores.forEach((d) => {
      // La cabecera interior monta dos instancias (escritorio y móvil): abrir
      // una cierra la otra.
      d.addEventListener('toggle', () => {
        if (d.open) cerrar(d);
      });

      d.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
        a.addEventListener('click', () => {
          const elegido = a.dataset.langSwitch === 'en' ? 'en' : 'es';
          try {
            localStorage.setItem('preferred_lang', elegido);
            localStorage.setItem('ln-lang', elegido);
          } catch (err) {
            /* almacenamiento bloqueado: la navegación funciona igual */
          }
        });
      });
    });

    document.addEventListener('click', (e) => {
      const destino = e.target as Node;
      selectores.forEach((d) => {
        if (d.open && !d.contains(destino)) d.removeAttribute('open');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      selectores.forEach((d) => {
        if (!d.open) return;
        d.removeAttribute('open');
        d.querySelector<HTMLElement>('summary')?.focus();
      });
    });
  }
</script>
