---
import { NAV_LINKS, type Lang } from '../../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const links = NAV_LINKS[lang];
const isEs = lang === 'es';
const voteLink = isEs ? '/es/como-votar/' : '/en/how-to-vote/';
const homeLink = isEs ? '/es/' : '/en/';
const logoSrc = isEs ? '/images/logo-es.png' : '/images/logo-en.png';
---

<header id="main-header" class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 md:h-24 transition-all" id="header-container">
      
      <!-- Candidate Logo / Lockup -->
      <a href={homeLink} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-navy-900 rounded p-1" aria-label={isEs ? 'Inicio - Guadalupe Lupe Negrete' : 'Home - Guadalupe Lupe Negrete'}>
        <img
          src={logoSrc}
          alt={isEs ? 'Guadalupe Lupe Negrete - Comisionado Precinto 4' : 'Guadalupe Lupe Negrete - Commissioner Precinct 4'}
          class="h-12 md:h-16 w-auto object-contain transition-transform group-hover:scale-102"
          width="200"
          height="64"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8" aria-label={isEs ? 'Navegación principal' : 'Main navigation'}>
        {links.map((link) => {
          const isActive = currentPath === link.href;
          if (link.isCta) {
            return (
              <a
                href={link.href}
                class="bg-navy-900 hover:bg-navy-950 text-white font-black px-5 py-2.5 rounded-lg text-sm tracking-wide shadow-md shadow-navy-950/20 hover:shadow-lg transition-all active:scale-98 focus:ring-4 focus:ring-navy-900/30"
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          }
          return (
            <a
              href={link.href}
              class={`text-sm font-bold tracking-wide transition-colors hover:text-red-cta focus:outline-none focus:ring-2 focus:ring-navy-900 rounded px-1 py-0.5 ${
                isActive ? 'text-red-cta font-black border-b-2 border-red-cta pb-1' : 'text-slate-700'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}

        <!-- Language Switcher -->
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
      </nav>

      <!-- Mobile Controls: Language Switcher & Hamburger -->
      <div class="flex md:hidden items-center gap-2">
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-lg text-navy-950 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-navy-900"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={isEs ? 'Abrir menú de navegación' : 'Open navigation menu'}
        >
          <svg class="w-6 h-6 icon-menu" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 icon-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-xl">
    <nav class="flex flex-col space-y-2" aria-label={isEs ? 'Menú móvil' : 'Mobile navigation'}>
      {links.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`block px-4 py-3 rounded-lg text-base font-bold transition-colors ${
              isActive
                ? 'bg-navy-50 text-red-cta border-l-4 border-red-cta'
                : 'text-slate-800 hover:bg-slate-100'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="pt-2">
      <a
        href={voteLink}
        class="w-full block text-center bg-red-cta text-white font-black py-3.5 px-4 rounded-lg text-base shadow-md"
      >
        {isEs ? 'DÓNDE Y CÓMO VOTAR' : 'WHERE & HOW TO VOTE'}
      </a>
    </div>
  </div>
</header>

<!-- Fixed Mobile Bottom CTA Bar -->
<div class="fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-300 p-2.5 md:hidden flex items-center justify-around shadow-2xl">
  <a
    href={voteLink}
    class="flex-1 text-center bg-navy-900 active:bg-navy-950 text-white font-black py-3 px-4 rounded-lg text-sm shadow-md flex items-center justify-center gap-2"
  >
    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>
    <span>{isEs ? 'CÓMO VOTAR' : 'HOW TO VOTE'}</span>
  </a>
</div>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = menuBtn?.querySelector('.icon-menu');
  const iconClose = menuBtn?.querySelector('.icon-close');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('hidden');
    iconMenu?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Sticky header height reduction on scroll
  window.addEventListener('scroll', () => {
    const headerContainer = document.getElementById('header-container');
    if (window.scrollY > 40) {
      headerContainer?.classList.remove('md:h-24');
      headerContainer?.classList.add('md:h-18');
    } else {
      headerContainer?.classList.remove('md:h-18');
      headerContainer?.classList.add('md:h-24');
    }
  }, { passive: true });
</script>
