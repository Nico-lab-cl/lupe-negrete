---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const label = lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content';
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-navy-950 focus:text-white focus:px-4 focus:py-2 focus:font-bold focus:shadow-lg focus:outline-none focus:ring-4 focus:ring-red-cta rounded"
>
  {label}
</a>
