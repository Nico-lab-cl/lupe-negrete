---
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="bg-white rounded-2xl border-2 border-navy-900 shadow-xl overflow-hidden">
  <div class="bg-navy-950 text-white p-4 md:p-6 flex items-center justify-between">
    <div class="space-y-1">
      <span class="text-xs font-black uppercase tracking-widest text-amber-400">
        {isEs ? 'Instrucción Visual' : 'Visual Step-by-Step'}
      </span>
      <h3 class="text-xl md:text-2xl font-black font-heading">
        {isEs ? 'Cómo Encontrar a Lupe en la Boleta Oficial' : 'How to Locate Lupe on the Official Ballot'}
      </h3>
    </div>
    <div class="hidden sm:block text-right">
      <span class="text-xs font-bold bg-navy-800 px-3 py-1.5 rounded border border-navy-700">
        {isEs ? 'Precinto 4 · Maverick County' : 'Precinct 4 · Maverick County'}
      </span>
    </div>
  </div>

  <div class="p-6 md:p-8 space-y-6">
    <p class="text-sm md:text-base text-slate-700 leading-relaxed">
      {isEs
        ? 'La boleta oficial de noviembre incluye cargos federales y estatales al inicio. El cargo de Comisionado de Condado se encuentra en la sección de elecciones locales de Maverick County. No te detengas arriba: baja hasta encontrar la casilla del Precinto 4.'
        : 'The November ballot lists federal and state offices at the top. The County Commissioner race is located in the local Maverick County section. Scroll down to find the Precinct 4 contest.'}
    </p>

    <!-- Simulated Ballot Section -->
    <div class="max-w-xl mx-auto bg-slate-50 p-6 rounded-xl border-2 border-dashed border-slate-300 font-mono text-xs md:text-sm space-y-4 shadow-inner">
      <div class="text-center pb-3 border-b border-slate-300">
        <p class="font-bold text-slate-600 uppercase tracking-widest">
          {isEs ? 'BOLETA ELECTORAL OFICIAL · CONDADO DE MAVERICK' : 'OFFICIAL GENERAL ELECTION BALLOT · MAVERICK COUNTY'}
        </p>
        <p class="text-[11px] text-slate-500">{isEs ? 'Elección General de Noviembre de 2026' : 'November 2026 General Election'}</p>
      </div>

      <div class="space-y-3">
        <div class="opacity-40 text-slate-500 select-none">
          <p class="font-bold">[ ... Cargos Federales y Estatales ... ]</p>
        </div>

        <!-- The Target Race Highlighted -->
        <div class="bg-white p-4 rounded-lg border-2 border-red-cta ring-4 ring-red-cta/20 shadow-md font-sans space-y-3">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <span class="font-black text-navy-950 text-sm md:text-base">
              {isEs ? 'COMISIONADO DEL CONDADO, PRECINTO 4' : 'COUNTY COMMISSIONER, PRECINCT 4'}
            </span>
            <span class="text-[11px] font-bold text-red-cta uppercase bg-red-50 px-2 py-0.5 rounded">
              {isEs ? 'Tu Voto Aquí' : 'Your Vote Here'}
            </span>
          </div>

          <div class="space-y-2">
            <!-- Candidate Selected -->
            <div class="flex items-center gap-3 bg-red-50 p-3 rounded-lg border border-red-200 text-ink font-bold">
              <div class="w-6 h-6 rounded-full border-2 border-red-cta bg-red-cta flex items-center justify-center text-white text-xs font-black shrink-0">
                ✓
              </div>
              <div class="flex-1 flex items-baseline justify-between">
                <span class="text-base text-navy-950 font-black">Guadalupe "Lupe" Negrete</span>
                <span class="text-xs font-bold text-red-cta bg-white px-2 py-0.5 rounded border border-red-200">
                  (REP)
                </span>
              </div>
            </div>

            <!-- Rival Candidate Unselected -->
            <div class="flex items-center gap-3 p-3 rounded-lg border border-slate-200 text-slate-500 opacity-60">
              <div class="w-6 h-6 rounded-full border-2 border-slate-300 shrink-0"></div>
              <div class="flex-1 flex items-baseline justify-between">
                <span class="text-sm">Alejandro Esquivel</span>
                <span class="text-xs">(DEM)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center pt-2 text-[11px] text-slate-500">
        <p>{isEs ? 'Marca claramente el óvalo o casilla junto al nombre de Lupe Negrete.' : 'Clearly fill in the oval or box next to Guadalupe "Lupe" Negrete.'}</p>
      </div>
    </div>
  </div>
</div>
