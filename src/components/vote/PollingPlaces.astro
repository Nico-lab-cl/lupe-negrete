---
import pollingData from '../../content/vote/polling-places.json';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === 'es';
const { earlyVoting, electionDay, lastVerified, verificationSource } = pollingData;
---

<div class="space-y-6">
  <!-- Interactive Tab Controls -->
  <div class="flex flex-wrap gap-3 border-b border-slate-300 pb-4" role="tablist" aria-label={isEs ? 'Pestañas de centros de votación' : 'Polling places tabs'}>
    <button
      type="button"
      id="tab-early-btn"
      class="px-5 py-2.5 rounded-lg font-black text-sm tracking-wide transition-all bg-navy-900 text-white shadow-md cursor-pointer focus:ring-4 focus:ring-navy-900/30"
      role="tab"
      aria-selected="true"
      aria-controls="panel-early"
    >
      {isEs ? '1. Votación Temprana (19–30 Oct)' : '1. Early Voting (Oct 19–30)'}
    </button>
    <button
      type="button"
      id="tab-election-btn"
      class="px-5 py-2.5 rounded-lg font-black text-sm tracking-wide transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-300 cursor-pointer focus:ring-4 focus:ring-navy-900/30"
      role="tab"
      aria-selected="false"
      aria-controls="panel-election"
    >
      {isEs ? '2. Día de la Elección (3 Nov)' : '2. Election Day (Nov 3)'}
    </button>
  </div>

  <!-- Panel: Early Voting -->
  <div id="panel-early" class="space-y-4" role="tabpanel" aria-labelledby="tab-early-btn">
    <div class="bg-amber-50 border border-amber-300/80 p-4 rounded-xl text-xs md:text-sm text-amber-950 flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <strong>{isEs ? 'Ventaja de la Votación Temprana:' : 'Early Voting Advantage:'}</strong>{' '}
        {isEs
          ? 'Durante el 19 al 30 de octubre, cualquier votante registrado de Maverick County puede votar en cualquiera de estos centros, sin importar su casilla específica.'
          : 'Between October 19 and 30, any registered voter in Maverick County may cast their ballot at any designated early voting location.'}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {earlyVoting.map((loc) => (
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="inline-block px-2.5 py-1 rounded bg-navy-100 text-navy-900 font-bold text-xs">
              {loc.precinct}
            </span>
            <h4 class="text-lg font-black text-navy-950 leading-snug">
              {isEs ? loc.nameEs : loc.nameEn}
            </h4>
            <p class="text-sm text-slate-700 flex items-start gap-2">
              <svg class="w-4 h-4 text-red-cta shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <span>{loc.address}</span>
            </p>
            <p class="text-xs text-slate-600 font-medium">
              <strong>{isEs ? 'Horario:' : 'Hours:'}</strong> {isEs ? loc.hoursEs : loc.hoursEn}
            </p>
          </div>

          <div>
            <a
              href={loc.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full bg-slate-100 hover:bg-slate-200 text-navy-950 font-bold py-2.5 px-4 rounded-lg text-xs tracking-wide transition-colors border border-slate-300"
              data-polling-place={loc.id}
            >
              <span>{isEs ? 'Abrir en Google Maps' : 'Open in Google Maps'}</span>
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Panel: Election Day -->
  <div id="panel-election" class="space-y-4 hidden" role="tabpanel" aria-labelledby="tab-election-btn">
    <div class="bg-navy-50 border border-navy-200 p-4 rounded-xl text-xs md:text-sm text-navy-950 flex items-start gap-3">
      <svg class="w-5 h-5 text-navy-800 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <div>
        <strong>{isEs ? 'Día de Elección General (3 de Noviembre):' : 'General Election Day (November 3):'}</strong>{' '}
        {isEs
          ? 'Las urnas abren a las 7:00 AM y cierran a las 7:00 PM. Si estás en la fila a las 7:00 PM, tienes derecho legal a votar.'
          : 'Polls are open from 7:00 AM to 7:00 PM. As long as you are in line by 7:00 PM, you are legally entitled to cast your vote.'}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {electionDay.map((loc) => (
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h4 class="text-base font-black text-navy-950 leading-snug">
              {isEs ? loc.nameEs : loc.nameEn}
            </h4>
            <p class="text-xs text-slate-700 flex items-start gap-1.5">
              <svg class="w-4 h-4 text-red-cta shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <span>{loc.address}</span>
            </p>
            <p class="text-xs text-slate-600 font-medium">
              <strong>{isEs ? 'Horario:' : 'Hours:'}</strong> {isEs ? loc.hoursEs : loc.hoursEn}
            </p>
            <p class="text-[11px] text-slate-500 italic bg-slate-50 p-2 rounded">
              {isEs ? loc.notesEs : loc.notesEn}
            </p>
          </div>

          <div>
            <a
              href={loc.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full bg-slate-100 hover:bg-slate-200 text-navy-950 font-bold py-2.5 px-4 rounded-lg text-xs tracking-wide transition-colors border border-slate-300"
              data-polling-place={loc.id}
            >
              <span>{isEs ? 'Abrir en Google Maps' : 'Open in Google Maps'}</span>
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Verification Citation -->
  <div class="text-[11px] text-slate-500 text-right pt-2 border-t border-slate-200">
    <p>{isEs ? 'Fuente verificada:' : 'Verified source:'} {verificationSource} · {isEs ? 'Actualizado:' : 'Updated:'} {lastVerified}</p>
  </div>
</div>

<script>
  import { trackEvent } from '../../lib/analytics';

  const earlyBtn = document.getElementById('tab-early-btn');
  const electionBtn = document.getElementById('tab-election-btn');
  const earlyPanel = document.getElementById('panel-early');
  const electionPanel = document.getElementById('panel-election');

  earlyBtn?.addEventListener('click', () => {
    earlyBtn.classList.add('bg-navy-900', 'text-white');
    earlyBtn.classList.remove('bg-white', 'text-slate-700');
    earlyBtn.setAttribute('aria-selected', 'true');

    electionBtn?.classList.remove('bg-navy-900', 'text-white');
    electionBtn?.classList.add('bg-white', 'text-slate-700');
    electionBtn?.setAttribute('aria-selected', 'false');

    earlyPanel?.classList.remove('hidden');
    electionPanel?.classList.add('hidden');
  });

  electionBtn?.addEventListener('click', () => {
    electionBtn.classList.add('bg-navy-900', 'text-white');
    electionBtn.classList.remove('bg-white', 'text-slate-700');
    electionBtn.setAttribute('aria-selected', 'true');

    earlyBtn?.classList.remove('bg-navy-900', 'text-white');
    earlyBtn?.classList.add('bg-white', 'text-slate-700');
    earlyBtn?.setAttribute('aria-selected', 'false');

    electionPanel?.classList.remove('hidden');
    earlyPanel?.classList.add('hidden');
  });

  // Track map clicks
  document.querySelectorAll('[data-polling-place]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const placeId = (e.currentTarget as HTMLElement).getAttribute('data-polling-place');
      trackEvent('polling_place_click', { place_id: placeId });
    });
  });
</script>
