---
import { SITE_CONFIG } from '../../config/site';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
// Texto legal — verificar con asesor electoral antes de desplegar. Texas Ethics Commission. No editar.
const disclaimer = SITE_CONFIG.committee.disclaimerTextEn;
---

<div class={`text-xs text-slate-500 border border-slate-300/80 bg-white/60 dark:bg-navy-950/40 px-3 py-2 rounded text-center tracking-wide font-medium ${className}`}>
  <p>{disclaimer}</p>
</div>
