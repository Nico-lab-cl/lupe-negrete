---
// Aviso emergente de votación anticipada en la home.
//
// Va en un <dialog> nativo (cierre con Esc, foco atrapado y fondo inerte sin
// código extra). scripts/votacion-anticipada.ts decide si se abre: una vez al
// día por visitante, 1,8 s después de cargar, y nunca encima de un video
// abierto ni cuando ya pasó la elección. Se mide en Clarity como
// early_vote_popup / early_vote_popup_close.
import type { Lang } from '../../lib/i18n';
import { routes } from '../site/SiteChrome';
import { SITIO_ANTICIPADA } from '../../lib/votacion-anticipada';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const R = routes(lang);
const es = lang === 'es';
const t = es
  ? {
      etiqueta: 'Aviso de votación anticipada',
      kicker: 'Votación anticipada · 19–30 oct',
      titulo: 'Ya puedes votar antes del 3 de noviembre',
      detalle: 'Cualquier votante de Maverick County puede votar ahí, sin importar su casilla.',
      llegar: 'Cómo llegar',
      horario: 'Ver horario y video',
      casilla: 'Ver mi casilla',
      ahoraNo: 'Ahora no',
      cerrar: 'Cerrar aviso'
    }
  : {
      etiqueta: 'Early voting notice',
      kicker: 'Early voting · Oct 19–30',
      titulo: 'You can vote before November 3',
      detalle: 'Any Maverick County voter can vote there, no matter their precinct.',
      llegar: 'Get directions',
      horario: 'See hours and video',
      casilla: 'Find my polling place',
      ahoraNo: 'Not now',
      cerrar: 'Close notice'
    };
---

<dialog class="vp" data-va-popup aria-labelledby="vp-titulo">
<div class="vp__caja" data-va-root>
<button type="button" class="vp__x" data-va-cerrar aria-label={t.cerrar} title={t.cerrar}>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
</button>
<div class="vp__banda">
<span class="vp__punto" aria-hidden="true"></span>{t.kicker}
</div>
<div class="vp__cuerpo">
<h2 id="vp-titulo" class="vp__titulo" data-va-titulo>{t.titulo}</h2>
<p class="vp__detalle" data-va-detalle>{t.detalle}</p>

<div class="vp__lugar" data-va-solo-anticipada>
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.1 7-12a7 7 0 10-14 0c0 5.9 7 12 7 12z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
<div>
<p class="vp__lugarNombre">{SITIO_ANTICIPADA.nombre}</p>
<p class="vp__lugarDir">{SITIO_ANTICIPADA.direccion} · Eagle Pass, TX</p>
</div>
</div>

<div class="vp__acciones">
<a href={SITIO_ANTICIPADA.maps} target="_blank" rel="noopener noreferrer" class="vp__btn vp__btn--rojo" data-va-solo-anticipada data-va-evento="early_vote_directions" data-va-origen="popup">{t.llegar}</a>
<a href="#anticipada" class="vp__btn vp__btn--navy" data-va-solo-anticipada data-va-evento="early_vote_details" data-va-origen="popup">{t.horario}</a>
<a href={R.vote} class="vp__btn vp__btn--rojo" data-va-solo-eleccion data-va-evento="early_vote_details" data-va-origen="popup">{t.casilla}</a>
</div>
<button type="button" class="vp__ahoraNo" data-va-cerrar>{t.ahoraNo}</button>
</div>
</div>
</dialog>

<style>
  .vp {
    border: none;
    padding: 0;
    background: transparent;
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow: visible;
    color: #14161a;
  }
  .vp::backdrop {
    background: rgba(6, 19, 43, 0.78);
    backdrop-filter: blur(3px);
  }
  .vp[open] .vp__caja {
    animation: lnUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .vp__caja {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-x: hidden;
    overflow-y: auto;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }
  .vp__x {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(6, 19, 43, 0.35);
    color: #fff;
    cursor: pointer;
  }
  .vp__x:hover {
    background: #06132b;
  }
  .vp__x:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .vp__banda {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #d3151d;
    color: #fff;
    padding: 16px 56px 14px 20px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .vp__punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    animation: lnPulse 1.6s infinite;
    flex: none;
  }
  .vp__cuerpo {
    padding: 20px 20px 16px;
  }
  .vp__titulo {
    margin: 0 0 8px;
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(30px, 8vw, 38px);
    line-height: 0.95;
    text-transform: uppercase;
    color: #06132b;
    text-wrap: balance;
  }
  .vp__detalle {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.5;
    color: #475467;
  }
  .vp__lugar {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    background: #f7f5f0;
    border-left: 4px solid #d3151d;
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 16px;
    color: #d3151d;
  }
  .vp__lugar svg {
    flex: none;
    margin-top: 2px;
  }
  .vp__lugar p {
    margin: 0;
  }
  .vp__lugarNombre {
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    font-size: 23px;
    line-height: 1.05;
    text-transform: uppercase;
    color: #06132b;
  }
  .vp__lugarDir {
    font-size: 14.5px;
    color: #344054;
  }
  .vp__acciones {
    display: grid;
    gap: 10px;
  }
  .vp__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 13px 18px;
    border-radius: 5px;
  }
  .vp__btn--rojo {
    background: #d3151d;
    color: #fff;
    box-shadow: 0 8px 22px rgba(211, 21, 29, 0.3);
  }
  .vp__btn--rojo:hover {
    background: #b50e15;
    color: #fff;
  }
  .vp__btn--navy {
    border: 1.5px solid #06132b;
    color: #06132b;
  }
  .vp__btn--navy:hover {
    background: #06132b;
    color: #fff;
  }
  .vp__ahoraNo {
    display: block;
    margin: 10px auto 0;
    padding: 10px 14px;
    border: none;
    background: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #667085;
    cursor: pointer;
  }
  .vp__ahoraNo:hover {
    color: #06132b;
  }

  [data-va-solo-eleccion] {
    display: none;
  }
  .vp__caja:is([data-fase='entre'], [data-fase='eleccion']) [data-va-solo-anticipada] {
    display: none;
  }
  .vp__caja:is([data-fase='entre'], [data-fase='eleccion']) [data-va-solo-eleccion] {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .vp[open] .vp__caja,
    .vp__punto {
      animation: none;
    }
  }
</style>
