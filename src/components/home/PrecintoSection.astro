---
// Sección del territorio con el mapa satelital. Es componente aparte porque
// su lugar en la portada cambia según la propuesta de orden (ver HomeLanding).
// El mapa lo monta home-landing.ts sobre [data-map].
import { COPY } from '../../lib/home-copy';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
---

<section id="precinto" style="background:#fff">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,78px) clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:clamp(32px,5vw,52px);align-items:center">
<div data-rv="0">
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.terrKicker}</p>
<h2 style="margin:0 0 16px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(38px,4.6vw,66px);line-height:.88;letter-spacing:-.012em;text-transform:uppercase;color:#06132B">{t.terrH2}</h2>
<p style="margin:0 0 24px;font-size:16.5px;line-height:1.7;color:#475467;text-wrap:pretty">{t.terrBody}</p>
<div style="display:flex;flex-wrap:wrap;gap:9px;margin-bottom:26px">
<span style="background:#F7F5F0;border:1px solid #E4E7EC;font-size:12.5px;font-weight:500;color:#06132B;padding:8px 13px;border-radius:100px">Loma Bonita</span>
<span style="background:#F7F5F0;border:1px solid #E4E7EC;font-size:12.5px;font-weight:500;color:#06132B;padding:8px 13px;border-radius:100px">Seco Mines</span>
<span style="background:#F7F5F0;border:1px solid #E4E7EC;font-size:12.5px;font-weight:500;color:#06132B;padding:8px 13px;border-radius:100px">Eagle Pass</span>
</div>
<a href="#sumate" class="h-cta" style="display:inline-flex;align-items:center;gap:8px;background:#D3151D;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:14px 26px;border-radius:5px;box-shadow:0 8px 24px rgba(211,21,29,.28)">{t.joinArrow}</a>
</div>
<div data-rv="0.14">
<div style="position:relative;border-radius:8px;overflow:hidden;border:1px solid #102D66;box-shadow:0 22px 54px rgba(6,19,43,.24)">
<div data-map style="width:100%;aspect-ratio:4/3;min-height:330px;background:#0B224E"></div>
<div style="position:absolute;top:0;left:0;z-index:600;display:flex;align-items:stretch;transform:skewX(-12deg) translateX(-6px);pointer-events:none;box-shadow:0 6px 18px rgba(0,0,0,.34)">
<span style="display:flex;align-items:center;background:#D3151D;padding:8px 12px 7px 18px"><span style="display:block;transform:skewX(12deg);font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:17px;line-height:1;letter-spacing:.04em;text-transform:uppercase;color:#fff">{t.mapTitle}</span></span>
<span style="display:flex;align-items:center;background:#06132B;padding:8px 15px 7px"><span style="display:block;transform:skewX(12deg);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:10px;line-height:1;letter-spacing:.14em;text-transform:uppercase;color:#F59E0B">{t.mapSat}</span></span>
</div>
</div>
<p style="margin:12px 0 0;font-size:12.5px;line-height:1.6;color:#5B6470">{t.mapNote}</p>
</div>
</div>
</section>
