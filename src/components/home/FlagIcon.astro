---
// Banderas dibujadas como SVG inline a propósito: los emoji de bandera
// (🇲🇽 🇺🇸) no tienen glifo en Windows y se ven como las letras "MX" / "US",
// que es justo donde está la mayor parte del tráfico de escritorio.
interface Props {
  country: 'mx' | 'us';
}

const { country } = Astro.props;

const frame =
  'display:block;flex:none;border-radius:1.5px;box-shadow:0 0 0 .5px rgba(0,0,0,.3)';
---

{
  country === 'mx' ? (
    <svg width="18" height="12" viewBox="0 0 3 2" aria-hidden="true" style={frame}>
      <rect width="1" height="2" fill="#006847" />
      <rect x="1" width="1" height="2" fill="#FFFFFF" />
      <rect x="2" width="1" height="2" fill="#CE1126" />
    </svg>
  ) : (
    <svg width="18" height="12" viewBox="0 0 13 7" aria-hidden="true" style={frame}>
      <rect width="13" height="7" fill="#FFFFFF" />
      <rect width="13" height="1" y="0" fill="#B22234" />
      <rect width="13" height="1" y="2" fill="#B22234" />
      <rect width="13" height="1" y="4" fill="#B22234" />
      <rect width="13" height="1" y="6" fill="#B22234" />
      <rect width="5.6" height="4" fill="#3C3B6E" />
      <g fill="#FFFFFF">
        <circle cx="1.1" cy="0.8" r="0.28" />
        <circle cx="2.8" cy="0.8" r="0.28" />
        <circle cx="4.5" cy="0.8" r="0.28" />
        <circle cx="1.95" cy="2" r="0.28" />
        <circle cx="3.65" cy="2" r="0.28" />
        <circle cx="1.1" cy="3.2" r="0.28" />
        <circle cx="2.8" cy="3.2" r="0.28" />
        <circle cx="4.5" cy="3.2" r="0.28" />
      </g>
    </svg>
  )
}
