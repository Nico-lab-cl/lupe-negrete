<style>
  /* ---------- Hero ----------
     El titular se apoya en color plano; la foto del candidato entra a sangre
     por la derecha y se disuelve en ese color con una mascara en degradado,
     asi que no hay borde ni marco: el navy se convierte en foto. */
  .hero__inner {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 24px);
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: stretch;
  }

  .hero__foto {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(62%, 980px);
    pointer-events: none;
  }
  .hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 2%;
    display: block;
    /* La disolucion. Va sobre la imagen y sobre el tinte a la vez, por eso
       la mascara se declara en el contenedor. */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, .3) 11%, rgba(0, 0, 0, .86) 27%, #000 40%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, .3) 11%, rgba(0, 0, 0, .86) 27%, #000 40%);
  }
  /* Tinte navy sobre la zona de disolucion: la foto es de fondo claro y sin
     esto el degradado saltaria de azul oscuro a blanco de golpe. */
  .hero__tinte {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(6, 19, 43, .95) 0%, rgba(6, 19, 43, .66) 15%, rgba(6, 19, 43, .24) 31%, rgba(6, 19, 43, .04) 52%, rgba(6, 19, 43, 0) 70%);
  }

  /* Franja roja inclinada, a la altura de la disolucion. */
  .hero__franja {
    position: absolute;
    left: 48%;
    top: 0;
    bottom: 0;
    width: 170px;
    background: #ff3131;
    opacity: .09;
    transform: skewX(-12deg);
    pointer-events: none;
  }

  /* Columna derecha: no lleva contenido, solo reserva el aire de la foto y
     sostiene el boton de play abajo a la derecha, como en el original. */
  .hero__lado {
    position: relative;
    min-height: clamp(400px, 54vw, 620px);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding-bottom: clamp(28px, 4vw, 56px);
  }

  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
  }
  .hero__playCirculo {
    position: relative;
    flex: none;
    width: clamp(72px, 7vw, 96px);
    height: clamp(72px, 7vw, 96px);
    border-radius: 50%;
    background: rgba(255, 255, 255, .92);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d3151d;
    box-shadow: 0 16px 40px rgba(6, 19, 43, .38);
    transition: background .3s, transform .3s;
  }
  .hero__play:hover .hero__playCirculo {
    background: #fff;
    transform: scale(1.06);
  }
  .hero__playTexto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-shadow: 0 2px 14px rgba(6, 19, 43, .55);
  }
  .hero__playTitulo {
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(17px, 1.6vw, 21px);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
  }
  .hero__playPie {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .82);
  }

  /* Lema de campana, antes sobre la foto. */
  .hero__lema {
    display: inline-block;
    margin-top: 30px;
    background: #ff3131;
    color: #fff;
    padding: 10px 17px;
    transform: skewX(-12deg);
    box-shadow: 0 12px 28px rgba(0, 0, 0, .3);
  }
  .hero__lema span {
    display: block;
    transform: skewX(12deg);
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    letter-spacing: .03em;
    text-transform: uppercase;
    font-size: clamp(15px, 3.8vw, 19px);
  }

  /* ---------- Propuestas ----------
     El video encabeza la seccion; debajo, las tres promesas en texto. */
  .prop-video {
    margin: 0 0 clamp(32px, 5vw, 52px);
  }
  .prop-video video {
    width: 100%;
    max-width: 980px;
    background: #06132b;
    border-radius: 8px;
    box-shadow: 0 24px 60px rgba(6, 19, 43, .22);
  }
  .prop-video__h {
    display: block;
    aspect-ratio: 16 / 9;
  }
  /* La version vertical solo existe en pantallas estrechas; en escritorio ni
     se muestra ni se descarga (preload="none" y sin poster visible). */
  .prop-video__v {
    display: none;
    aspect-ratio: 9 / 16;
    max-width: min(100%, 420px);
    margin: 0 auto;
  }
  .prop-video__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    max-width: 980px;
    margin-top: 14px;
  }
  .prop-video__titulo {
    font-family: 'Saira Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(19px, 2.2vw, 24px);
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #06132b;
  }
  .prop-video__meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #667085;
  }

  .prop-grid {
