---
// Portado 1:1 desde "Home Lupe Negrete.dc.html" (Claude Design).
// Los estilos inline se conservan tal cual; los antiguos atributos
// style-hover / style-focus viven ahora como clases en LandingLayout.astro
// y los bloques <sc-if> como condicionales de Astro o toggles de CSS.
// La cabecera, el pie y la barra fija salieron a components/site para que las
// paginas interiores usen exactamente el mismo chrome.
import { COPY } from '../../lib/home-copy';
import type { Lang } from '../../lib/i18n';
import TopBar from '../site/TopBar.astro';
import SiteHeader from '../site/SiteHeader.astro';
import SiteFooter from '../site/SiteFooter.astro';
import StickyBar from '../site/StickyBar.astro';
import { routes, diasRestantes as calcDias } from '../site/SiteChrome';

interface Props {
  lang: Lang;
  showDonaciones?: boolean;
  showCountdown?: boolean;
}

const { lang, showDonaciones = true, showCountdown = true } = Astro.props;

const t = COPY[lang];
const R = routes(lang);

// Valor renderizado en build; el script del cliente lo recalcula al cargar.
const diasRestantes = calcDias();
---

<div style="min-height:100vh;background:#F7F5F0">

<TopBar lang={lang} isHome showCountdown={showCountdown} />
<SiteHeader lang={lang} isHome />

<main id="main-content">

<section id="top" style="position:relative;background:#06132B;overflow:hidden">
<div data-px="0.14" style="position:absolute;top:-120px;right:-60px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(0,51,153,.5),transparent 68%);pointer-events:none"></div>
<div data-px="0.07" data-pxb="skewX(-12deg)" style="position:absolute;left:52%;top:0;bottom:0;width:180px;background:#FF3131;opacity:.1;transform:skewX(-12deg);pointer-events:none"></div>
<div style="position:relative;max-width:1280px;margin:0 auto;padding:0 clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(24px,4vw,48px);align-items:stretch">

<div style="padding:clamp(38px,6vw,62px) 0 clamp(40px,6vw,74px);animation:lnUp .6s cubic-bezier(.16,1,.3,1) both">
<div style="display:inline-flex;align-items:stretch;margin-bottom:28px;transform:skewX(-12deg);box-shadow:0 8px 22px rgba(0,0,0,.32)">
<span style="display:flex;align-items:center;background:#FF3131;padding:8px 13px 7px"><span style="display:block;transform:skewX(12deg);font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:23px;line-height:1;letter-spacing:.02em;color:#fff">P4</span></span>
<span style="display:flex;flex-direction:column;justify-content:center;gap:2px;background:#fff;padding:7px 15px 6px">
<span style="display:block;transform:skewX(12deg);font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:15px;line-height:1;letter-spacing:.06em;text-transform:uppercase;color:#06132B">{t.badgeSeat}</span>
<span style="display:block;transform:skewX(12deg);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:9.5px;line-height:1;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.badgeCounty}</span>
</span>
</div>

<h1 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(44px,10vw,116px);line-height:.83;letter-spacing:-.012em;text-transform:uppercase;color:#fff">
<span style="display:block">{t.h1a}</span>
<span style="display:block">{t.h1b}</span>
<span style="display:block;color:#FF3131">{t.h1c}</span>
</h1>

<div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px clamp(12px,2.6vw,18px);margin:28px 0 18px">
<span style="flex:none;width:46px;height:4px;background:#FF3131;transform:skewX(-12deg)"></span>
<p style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(18px,4.4vw,23px);letter-spacing:.03em;text-transform:uppercase;color:#fff">{t.mottoA}</p>
<span style="flex:none;width:2px;height:19px;background:#FF3131;transform:skewX(-12deg)"></span>
<p style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(18px,4.4vw,23px);letter-spacing:.03em;text-transform:uppercase;color:#fff">{t.mottoB}</p>
<span style="flex:none;width:2px;height:19px;background:#FF3131;transform:skewX(-12deg)"></span>
<p style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:clamp(18px,4.4vw,23px);letter-spacing:.03em;text-transform:uppercase;color:#fff">{t.mottoC}</p>
</div>

<p style="margin:0;max-width:520px;font-size:clamp(15px,3.6vw,16.5px);line-height:1.65;color:rgba(255,255,255,.72)">{t.heroBody}</p>

<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:30px">
<a href="#votar" class="h-cta" style="background:#D3151D;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px;box-shadow:0 8px 26px rgba(211,21,29,.36)">{t.heroCtaVote}</a>
<a href="#conoce" class="h-ghost" style="background:transparent;border:1.5px solid rgba(255,255,255,.34);color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:15px 26px;border-radius:5px">{t.navMeet}</a>
</div>

<p style="margin:34px 0 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.14);font-size:12px;font-weight:500;letter-spacing:.03em;color:rgba(255,255,255,.5)">{t.heroId}</p>
</div>

<div style="position:relative;display:flex;align-items:flex-end;justify-content:center;min-height:clamp(340px,52vw,520px)">
<div style="position:absolute;bottom:0;right:-24px;left:-24px;top:44px;background:#0B224E;clip-path:polygon(9% 0,100% 0,100% 100%,0 100%)"></div>
<img data-px="-0.055" src="/images/hero-candidate-walking.png" alt="Lupe Negrete caminando con vecinos en las calles del Precinto 4" style="position:relative;width:100%;max-width:430px;height:auto;display:block;filter:drop-shadow(0 24px 50px rgba(0,0,0,.5))" />
<div style="position:absolute;bottom:26px;left:0;background:#FF3131;color:#fff;padding:11px 18px;transform:skewX(-12deg)">
<span style="display:block;transform:skewX(12deg);font-family:'Saira Condensed',sans-serif;font-weight:800;letter-spacing:.03em;text-transform:uppercase;font-size:clamp(15px,3.8vw,19px)">{t.heroQuote}</span>
</div>
</div>

</div>
</section>

<section id="sumate" style="background:#0B224E;border-top:4px solid #FF3131">
<div style="max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,56px) clamp(16px,4vw,24px) clamp(44px,6vw,60px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:48px;align-items:center">
<div data-rv="0">
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#FF3131">{t.signupKicker}</p>
<h2 style="margin:0 0 14px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(34px,3.6vw,52px);line-height:.92;letter-spacing:-.01em;text-transform:uppercase;color:#fff">{t.signupH2}</h2>
<p style="margin:0;font-size:15.5px;line-height:1.65;color:rgba(255,255,255,.68)">{t.signupSub}</p>
</div>
<div data-rv="0.14" data-form-wrap style="background:#fff;border-radius:8px;padding:clamp(20px,4vw,30px);box-shadow:0 24px 60px rgba(0,0,0,.35)">
<div data-thanks style="text-align:center;padding:18px 0">
<div style="width:60px;height:60px;margin:0 auto 16px;border-radius:50%;background:#ECFDF5;color:#059669;display:flex;align-items:center;justify-content:center">
<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
</div>
<h3 style="margin:0 0 8px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:30px;text-transform:uppercase;color:#06132B">{t.thanksH}</h3>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#475467">{t.thanksBody}</p>
<a href="#top" class="h-navy" style="display:inline-block;background:#06132B;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:18px;letter-spacing:.03em;text-transform:uppercase;padding:13px 24px;border-radius:5px">{t.share}</a>
</div>
<form data-signup data-lang={lang} novalidate>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(190px,100%),1fr));gap:14px">
<div style="display:flex;flex-direction:column;gap:6px">
<label for="ln-nombre" style="font-size:12.5px;font-weight:600;letter-spacing:.02em;color:#06132B">{t.fName}</label>
<input id="ln-nombre" name="nombre" type="text" required autocomplete="name" placeholder={t.phName} class="fld" style="width:100%;padding:13px 14px;border:1px solid #D0D5DD;border-radius:5px;background:#F7F5F0;font-size:15px;color:#14161A;outline:none" />
</div>
<div style="display:flex;flex-direction:column;gap:6px">
<label for="ln-email" style="font-size:12.5px;font-weight:600;letter-spacing:.02em;color:#06132B">{t.fEmail}</label>
<input id="ln-email" name="email" type="email" required autocomplete="email" placeholder={t.phEmail} class="fld" style="width:100%;padding:13px 14px;border:1px solid #D0D5DD;border-radius:5px;background:#F7F5F0;font-size:15px;color:#14161A;outline:none" />
</div>
<div style="display:flex;flex-direction:column;gap:6px">
<label for="ln-tel" style="font-size:12.5px;font-weight:600;letter-spacing:.02em;color:#06132B">{t.fPhone} <span style="font-weight:400;color:#5B6470">{t.fPhoneOpt}</span></label>
<input id="ln-tel" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="(830) 000-0000" class="fld" style="width:100%;padding:13px 14px;border:1px solid #D0D5DD;border-radius:5px;background:#F7F5F0;font-size:15px;color:#14161A;outline:none" />
</div>
<div style="display:flex;flex-direction:column;gap:6px">
<label for="ln-zip" style="font-size:12.5px;font-weight:600;letter-spacing:.02em;color:#06132B">{t.fZip}</label>
<input id="ln-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="78852" class="fld" style="width:100%;padding:13px 14px;border:1px solid #D0D5DD;border-radius:5px;background:#F7F5F0;font-size:15px;font-family:'IBM Plex Mono',monospace;color:#14161A;outline:none" />
</div>
</div>
<button type="submit" class="h-cta" style="width:100%;margin-top:18px;background:#D3151D;color:#fff;border:none;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:21px;letter-spacing:.04em;text-transform:uppercase;padding:15px;border-radius:5px;cursor:pointer;box-shadow:0 8px 24px rgba(211,21,29,.3)">{t.submit}</button>
<p style="margin:14px 0 0;font-size:11px;line-height:1.5;color:#5B6470">{t.consent} <a href={R.privacy}>{t.privacy}</a>.</p>
</form>
</div>
</div>
</section>

<section style="background:#F7F5F0;border-bottom:1px solid #E4E7EC">
<div style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,64px) clamp(16px,4vw,24px)">
<div data-rv="0" style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px;flex-wrap:wrap">
<div>
<p style="margin:0 0 8px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.vidKicker}</p>
<h2 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(32px,3.8vw,54px);line-height:.92;letter-spacing:-.01em;text-transform:uppercase;color:#06132B">{t.vidH2}</h2>
</div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:20px">
<div data-rv="0" style="position:relative;aspect-ratio:16/10;border-radius:6px;overflow:hidden;background:#0B224E;border:1px solid #E4E7EC">
<img src="/images/candidate-assembly.png" alt="Lupe Negrete en asamblea vecinal" loading="lazy" style="width:100%;height:100%;object-fit:cover;opacity:.5" />
<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:linear-gradient(to top,rgba(6,19,43,.86),rgba(6,19,43,.4))">
<span style="width:56px;height:56px;border-radius:50%;border:2px solid rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;color:#fff"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
<span style="font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:18px;letter-spacing:.05em;text-transform:uppercase;color:#fff">{t.vid1}</span>
</div>
</div>
<div data-rv="0.13" style="position:relative;aspect-ratio:16/10;border-radius:6px;overflow:hidden;background:#0B224E;border:1px solid #E4E7EC">
<img src="/images/candidate-listening.png" alt="Lupe Negrete escuchando a vecinos" loading="lazy" style="width:100%;height:100%;object-fit:cover;opacity:.5" />
<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:linear-gradient(to top,rgba(6,19,43,.86),rgba(6,19,43,.4))">
<span style="width:56px;height:56px;border-radius:50%;border:2px solid rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;color:#fff"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
<span style="font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:18px;letter-spacing:.05em;text-transform:uppercase;color:#fff">{t.vid2}</span>
</div>
</div>
<div data-rv="0.26" style="position:relative;aspect-ratio:16/10;border-radius:6px;overflow:hidden;background:#0B224E;border:1px solid #E4E7EC">
<img src="/images/candidate-border.png" alt="Lupe Negrete con vista al Río Bravo y Eagle Pass al atardecer" loading="lazy" style="width:100%;height:100%;object-fit:cover;opacity:.5" />
<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:linear-gradient(to top,rgba(6,19,43,.86),rgba(6,19,43,.4))">
<span style="width:56px;height:56px;border-radius:50%;border:2px solid rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;color:#fff"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
<span style="font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:18px;letter-spacing:.05em;text-transform:uppercase;color:#fff">{t.vid3}</span>
</div>
</div>
</div>
</div>
</section>

<section id="conoce" style="background:#fff;overflow:hidden">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,78px) clamp(16px,4vw,24px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:clamp(32px,5vw,60px);align-items:center">
<div style="position:relative">
<div data-px="0.11" style="position:absolute;top:-28px;left:-40px;width:210px;height:210px;border-radius:50%;background:#003399;opacity:.1"></div>
<div data-px="0.17" data-pxb="skewX(-12deg)" style="position:absolute;bottom:-30px;right:-18px;width:120px;height:120px;background:#FF3131;opacity:.14;transform:skewX(-12deg)"></div>
<img src="/images/candidate-portrait-navy.png" alt="Retrato oficial de Guadalupe Lupe Negrete" loading="lazy" width="1080" height="1350" style="position:relative;width:100%;height:auto;display:block;border-radius:6px;box-shadow:0 22px 54px rgba(6,19,43,.22)" />
</div>
<div data-rv="0.08">
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.meetKicker}</p>
<h2 style="margin:0 0 6px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(38px,4.6vw,68px);line-height:.88;letter-spacing:-.012em;text-transform:uppercase;color:#06132B">{t.meetH2}</h2>
<p style="margin:0 0 22px;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:22px;letter-spacing:.02em;text-transform:uppercase;color:#003399">{t.positioning}</p>
<p style="margin:0 0 16px;font-size:16.5px;line-height:1.72;color:#475467;max-width:600px;text-wrap:pretty">{t.meetP1}</p>
<p style="margin:0 0 28px;font-size:16.5px;line-height:1.72;color:#475467;max-width:600px;text-wrap:pretty">{t.meetP2}</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr));gap:1px;background:#E4E7EC;border:1px solid #E4E7EC;border-radius:6px;overflow:hidden;margin-bottom:28px;max-width:600px">
<div style="background:#fff;padding:18px 16px">
<p style="margin:0;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:26px;color:#06132B">4</p>
<p style="margin:4px 0 0;font-size:11.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#5B6470">{t.statPrecinct}</p>
</div>
<div style="background:#fff;padding:18px 16px">
<p style="margin:0;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:26px;color:#06132B">3</p>
<p style="margin:4px 0 0;font-size:11.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#5B6470">{t.statPriorities}</p>
</div>
<div style="background:#fff;padding:18px 16px">
<p style="margin:0;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:26px;color:#D3151D" data-cu data-days>{diasRestantes}</p>
<p style="margin:4px 0 0;font-size:11.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#5B6470">{t.statDays}</p>
</div>
</div>
<div style="display:flex;flex-wrap:wrap;gap:12px">
<a href={R.about} class="h-navy" style="background:#06132B;color:#fff;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:14px 24px;border-radius:5px">{t.readStory}</a>
<a href={R.contact} class="h-outline" style="border:1.5px solid #D0D5DD;color:#06132B;font-family:'Saira Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.03em;text-transform:uppercase;padding:14px 24px;border-radius:5px">{t.contactTeam}</a>
</div>
</div>
</div>
</section>

<section id="propuestas" style="background:#F7F5F0;border-top:1px solid #E4E7EC">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,78px) clamp(16px,4vw,24px)">
<div data-rv="0" style="max-width:820px;margin-bottom:44px">
<p style="margin:0 0 10px;font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#D3151D">{t.issuesKicker}</p>
<h2 style="margin:0 0 16px;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:clamp(38px,5vw,74px);line-height:.86;letter-spacing:-.015em;text-transform:uppercase;color:#06132B">{t.issuesH2}</h2>
<p style="margin:0;font-size:17px;line-height:1.68;color:#475467;text-wrap:pretty">{t.issuesSub}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:24px">

<article data-rv="0" class="h-card" style="background:#fff;border:1px solid #E4E7EC;border-top:5px solid #D3151D;border-radius:6px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s">
<div style="position:relative;aspect-ratio:16/10;overflow:hidden;background:#E4E7EC">
<img src="/images/candidate-assembly.png" alt="Lupe Negrete en asamblea comunitaria en calle sin pavimentar" loading="lazy" style="width:100%;height:100%;object-fit:cover" />
<span style="position:absolute;top:12px;left:0;background:#D3151D;color:#fff;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:6px 12px 6px 14px">{t.issueLabel1}</span>
</div>
<div style="padding:24px;display:flex;flex-direction:column;gap:12px;flex:1">
<h3 style="margin:0;font-family:'Saira Condensed',sans-serif;font-weight:800;font-size:30px;line-height:.95;text-transform:uppercase;color:#06132B">{t.issue1H}</h3>
<p style="margin:0;font-size:14.5px;line-height:1.66;color:#475467;flex:1">{t.issue1P}</p>
<a href={R.paving} class="h-nav" style="display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#06132B;padding-top:12px;border-top:1px solid #E4E7EC">{t.issue1Link}</a>
</div>
</article>

<article data-rv="0.13" class="h-card" style="background:#fff;border:1px solid #E4E7EC;border-top:5px solid #003399;border-radius:6px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s">
<div style="position:relative;aspect-ratio:16/10;overflow:hidden;background:#E4E7EC">
<img src="/images/candidate-listening.png" alt="Lupe Negrete conversando con vecinos sobre seguridad" loading="lazy" style="width:100%;height:100%;object-fit:cover" />
<span style="position:absolute;top:12px;left:0;background:#003399;color:#fff;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:6px 12px 6px 14px">{t.issueLabel2}</span>
</div>
<div style="padding:24px;display:flex;flex-direction:column;gap:12px;flex:1">
