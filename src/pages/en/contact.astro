---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignupForm from '../../components/conversion/SignupForm.astro';
import WhatsAppCTA from '../../components/conversion/WhatsAppCTA.astro';
import { SITE_CONFIG } from '../../config/site';
---

<BaseLayout
  title="Contact & Volunteer · Guadalupe 'Lupe' Negrete"
  description="Get in touch with the Lupe Negrete campaign for County Commissioner, Precinct 4 in Maverick County. Join as a volunteer or reach out via WhatsApp."
  lang="en"
>
  <section class="bg-navy-950 text-white py-14 md:py-20 border-b-4 border-red-cta">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-block bg-red-cta/20 border border-red-cta/40 text-red-logo text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">
        Grassroots Participation
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading text-white leading-tight">
        Join the Precinct 4 Team
      </h1>
      <p class="text-slate-300 text-lg max-w-2xl">
        This campaign is won on the ground, walking street by street and speaking with neighbors. Your support in your colonia is key to bringing real change.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct Communication & Trust Details -->
      <div class="lg:col-span-5 space-y-8">
        
        <!-- Direct WhatsApp Box -->
        <div class="bg-emerald-50 border-2 border-emerald-300 rounded-3xl p-6 md:p-8 space-y-4 shadow-md">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full">
            Immediate Channel
          </span>
          <h2 class="text-2xl font-black text-emerald-950">
            Message Us on WhatsApp
          </h2>
          <p class="text-sm text-emerald-900 leading-relaxed">
            Want to speak directly with our campaign organizers or report an issue on your street? Our WhatsApp channel is open for immediate responses.
          </p>
          <div class="pt-2">
            <WhatsAppCTA
              source="voluntario"
              lang="en"
              label="Open Volunteer Chat on WhatsApp"
              variant="primary"
              className="w-full"
            />
          </div>
        </div>

        <!-- Official Campaign Information -->
        <div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-200 shadow-sm space-y-6">
          <h3 class="text-lg font-black text-navy-950 border-b border-slate-200 pb-3">
            Official Campaign Information
          </h3>

          <div class="space-y-4 text-sm text-slate-700">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <strong class="block text-navy-950">Mailing Address</strong>
                <span>{SITE_CONFIG.committee.address}</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <strong class="block text-navy-950">Email Address</strong>
                <a href={`mailto:${SITE_CONFIG.committee.email}`} class="hover:underline text-navy-900 font-semibold">{SITE_CONFIG.committee.email}</a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-navy-100 text-navy-900 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
              </div>
              <div>
                <strong class="block text-navy-950">Legal Committee</strong>
                <span>{SITE_CONFIG.committee.legalName}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Volunteer Form -->
      <div class="lg:col-span-7">
        <SignupForm lang="en" formLocation="contact" isVolunteerForm={true} />
      </div>

    </div>
  </section>
</BaseLayout>
